# Copy this file to .env and fill in the blanks. Never commit .env.

# Astra DB
ASTRA_DB_TOKEN=AstraCS:paste-your-token-here
ASTRA_DB_KEYSPACE=default_keyspace

# Google AI Studio, needed from week 3. Leave empty until then.
GEMINI_API_KEY=

# Plain Apache Cassandra cluster only. Leave empty when you use Astra DB.
CASSANDRA_HOSTS=
CASSANDRA_CLIENT_PORT=
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_KEYSPACE=
